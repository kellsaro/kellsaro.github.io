#!/usr/bin/env bash
# Regenerates the downloadable CV (assets/docs/Maykell-Sanchez-Romero-CV.pdf)
# from the home page's print stylesheet, using headless Chrome.
# Run it after changing resume content (_data/resume.yml, index.md, resume.css).
set -euo pipefail

cd "$(dirname "$0")/.."
OUTPUT="assets/docs/Maykell-Sanchez-Romero-CV.pdf"
OUTPUT_ES="assets/docs/Maykell-Sanchez-Romero-CV-ES.pdf"
PORT="${PORT:-4199}"

CHROME="${CHROME:-}"
if [ -z "$CHROME" ]; then
  for candidate in \
    "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" \
    "$(command -v google-chrome || true)" \
    "$(command -v chromium || true)"; do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then CHROME="$candidate"; break; fi
  done
fi
[ -n "$CHROME" ] || { echo "Chrome not found; set CHROME=/path/to/chrome" >&2; exit 1; }

# Build into a private folder: a running `jekyll serve` rewrites _site with
# localhost URLs, which must never end up inside the published PDF.
BUILD_DIR="$(mktemp -d)"

echo "Building the site..."
# --unpublished renders the Spanish CV source (cv-es.md, published: false) so it can
# be printed to PDF. It is not published to the live site (GitHub Pages omits it).
JEKYLL_ENV=production bundle exec jekyll build --quiet --unpublished --destination "$BUILD_DIR"

echo "Serving the build on port $PORT..."
python3 -m http.server "$PORT" --directory "$BUILD_DIR" >/dev/null 2>&1 &
SERVER_PID=$!
trap 'kill $SERVER_PID 2>/dev/null || true; rm -rf "$BUILD_DIR"' EXIT
for _ in $(seq 1 30); do
  curl -s -o /dev/null "http://localhost:$PORT/" && break
  sleep 0.2
done

# Prints one CV page to a PDF and warns if it spills past two pages.
print_cv() {
  local url="$1" out="$2" label="$3"
  echo "Printing the $label CV..."
  "$CHROME" --headless=new --disable-gpu --no-pdf-header-footer \
    --print-to-pdf="$out" "$url" 2>/dev/null
  if command -v pdfinfo >/dev/null; then
    local pages
    pages=$(pdfinfo "$out" | awk '/^Pages:/ {print $2}')
    echo "Saved $out ($pages page(s))"
    [ "$pages" -le 2 ] || echo "Warning: the $label CV no longer fits on two pages; tighten the content or resume.css." >&2
  else
    echo "Saved $out"
  fi
}

print_cv "http://localhost:$PORT/" "$OUTPUT" "English"
print_cv "http://localhost:$PORT/cv-es/" "$OUTPUT_ES" "Spanish"
