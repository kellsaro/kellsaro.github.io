#!/usr/bin/env bash
# Renders tools/social-card.html into assets/img/social-card.png (1200x630),
# the image shown when the site's link is shared (LinkedIn, Slack, WhatsApp...).
set -euo pipefail

cd "$(dirname "$0")/.."
OUTPUT="assets/img/social-card.png"

CHROME="${CHROME:-}"
if [ -z "$CHROME" ]; then
  for candidate in \
    "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" \
    "$(command -v google-chrome || true)" \
    "$(command -v chromium || true)"; do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then CHROME="$candidate"; break; fi
  done
fi
[ -n "$CHROME" ] || { echo "Chrome not found; set CHROME=/path/to/chrome" >&2; exit 1; }

"$CHROME" --headless=new --disable-gpu --hide-scrollbars --window-size=1200,630 \
  --virtual-time-budget=5000 --screenshot="$OUTPUT" "file://$PWD/tools/social-card.html" 2>/dev/null
echo "Saved $OUTPUT"
